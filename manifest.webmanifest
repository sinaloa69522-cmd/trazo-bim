{
  "name": "Smartarchitect",
  "short_name": "Smartarchitect",
  "description": "Diseño de casas en planta y 3D con láminas, estructura, instalaciones y presupuesto.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#eef0ef",
  "theme_color": "#1f5fd1",
  "categories": ["productivity", "design", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-trazo": [".trazo"], "application/dxf": [".dxf"], "image/vnd.dwg": [".dwg"] } }
  ]
}
